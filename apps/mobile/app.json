{
  "expo": {
    "name": "FinPal",
    "slug": "finpal",
    "scheme": "finpal",
    "version": "0.1.0",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#040509",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#040509",
          "image": "./assets/splash-lockup.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
