# Where the FinPal web app (and its /api/v1) runs. Leave unset in development:
# the app then uses the machine running Metro, on port 3000.
# EXPO_PUBLIC_API_URL=https://finpal.example.com

# Needed only when the web app runs against a real Supabase project (not mock
# mode). Use the same values as the web app's NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY. The anon key is public by design.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
