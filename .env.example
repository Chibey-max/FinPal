# Public Supabase client settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase settings
SUPABASE_SERVICE_ROLE_KEY=

# PayPal Sandbox - centrally configured merchant account
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Product and merchant evaluation
CHANNEL3_API_KEY=
KERNEL_API_KEY=

# Google Calendar (optional): a Google OAuth client, so each user can connect
# their own calendar. See docs/operations.md. Without it, Connect is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq LLM (optional): plain-language decision explanations and proposal
# drafting from a sentence. Without a key FinPal uses rule-based text. The
# model only words things; it never changes a decision.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional. Agent shop uses this so Render does not time out. Unset: llama-3.1-8b-instant when GROQ_MODEL is gpt-oss.
GROQ_AGENT_MODEL=llama-3.1-8b-instant

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "mock" runs the real backend use cases on in-memory data with simulated
# PayPal Sandbox, Channel3, KERNEL and calendar (no keys needed). "live" uses
# the services above. Unset: mock in development until NEXT_PUBLIC_SUPABASE_URL
# is set; always live in production.
FINPAL_DATA_SOURCE=
LOG_LEVEL=info
# Personal FinPal balances (funded via PayPal Checkout after Log in with
# PayPal). Caps still limit sends per person (timezone) and everyone (UTC).
# Unset uses 250 and 1000. Enable Log in with PayPal on the Sandbox REST app
# with return URL {NEXT_PUBLIC_APP_URL}/api/v1/paypal/connect/callback.
SEND_DAILY_LIMIT_PER_USER=
SEND_DAILY_LIMIT_TOTAL=

