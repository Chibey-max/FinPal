# Public Supabase client settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase settings
SUPABASE_SERVICE_ROLE_KEY=

# PayPal Sandbox - centrally configured merchant account
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Product and merchant evaluation
CHANNEL3_API_KEY=
KERNEL_API_KEY=

# Google Calendar proposal prefill (optional; omit to leave calendar unconfigured)
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "mock" runs the real backend use cases on in-memory data with simulated
# PayPal Sandbox, Channel3, KERNEL and calendar (no keys needed). "live" uses
# the services above. Unset: mock in development until NEXT_PUBLIC_SUPABASE_URL
# is set; always live in production.
FINPAL_DATA_SOURCE=
LOG_LEVEL=info

